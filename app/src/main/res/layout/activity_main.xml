<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:layoutDirection="rtl">
<TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="پژوهش‌یار عنبیه" android:textSize="27sp" android:textStyle="bold" android:gravity="center" android:padding="8dp"/>
<TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="سامانه آموزشی و پژوهشی — غیرتشخیصی" android:textSize="16sp" android:gravity="center" android:paddingBottom="12dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="هشدار علمی: این برنامه برای تشخیص یا رد بیماری طراحی نشده است. نتایج عنبیه‌شناسی در این برنامه به‌عنوان ادعا/تفسیر منبع ثبت می‌شوند و با داده‌های پزشکی استاندارد برای پژوهش مقایسه می‌شوند." android:background="#FFF3CD" android:padding="12dp" android:textSize="14sp"/>
<Button android:id="@+id/pickButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="انتخاب عکس عنبیه" android:layout_marginTop="12dp"/>
<ImageView android:id="@+id/eyeImage" android:layout_width="match_parent" android:layout_height="280dp" android:scaleType="fitCenter" android:contentDescription="تصویر عنبیه" android:layout_marginTop="10dp"/>
<Button android:id="@+id/analyzeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تحلیل تصویری پژوهشی" android:enabled="false"/>
<TextView android:id="@+id/result" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:paddingTop="12dp" android:textIsSelectable="true"/>
<EditText android:id="@+id/searchBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="جستجو در متن کتاب…" android:singleLine="true" android:layout_marginTop="14dp"/>
<Button android:id="@+id/searchButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="جستجوی منبع"/>
<TextView android:id="@+id/searchResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textIsSelectable="true" android:paddingTop="8dp"/>
<Button android:id="@+id/protocolButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="پروتکل اعتبارسنجی پزشکی" android:layout_marginTop="10dp"/>
</LinearLayout></ScrollView>
